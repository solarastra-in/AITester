PORT=5000
DATA_DIR=./data

# Sign JWTs — set a real random value in production
JWT_SECRET=change-this-in-production

# First-run platform admin account (only used if no platform_admin exists yet)
PLATFORM_ADMIN_EMAIL=admin@verity.local
PLATFORM_ADMIN_PASSWORD=changeme123

# Free trial credits granted to self-serve standalone signups
STANDALONE_TRIAL_CREDITS=20

# Free in-console "preview" runs allowed per project per 24h before the
# platform requires hosted (paid) execution or a self-hosted export
PREVIEW_DAILY_CAP=15
