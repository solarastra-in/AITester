# CORS_ALLOWED_ORIGINS: comma-separated list of origins allowed to call this
# API cross-origin, e.g. "https://verity.whyor.in,https://your-preview.vercel.app".
# In production with this unset, the server reflects any origin (logged as a
# warning at startup) — set this for a real production deployment.
CORS_ALLOWED_ORIGINS=

# JWT_SECRET: REQUIRED in production. Signs and verifies all auth tokens.
# The server refuses to start with NODE_ENV=production if this is unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# FIREBASE_SERVICE_ACCOUNT_KEY: REQUIRED in production unless running on
# infrastructure with Application Default Credentials available (e.g.
# Cloud Run, which gets this automatically from its own service account —
# no need to set this var there). REQUIRED on Vercel and any other
# platform without ADC, since there's no other way for the server to
# authenticate to Firestore.
#
# This is the full JSON key file for a service account with Firestore
# read/write access on this project (gen-lang-client-0433516004), as a
# single-line string. Create one via Google Cloud Console -> IAM & Admin
# -> Service Accounts -> Create Service Account -> grant it the
# "Cloud Datastore User" role (covers Firestore) -> Keys -> Add Key ->
# JSON -> download it, then paste its full contents here as one line.
FIREBASE_SERVICE_ACCOUNT_KEY=

# FIRESTORE_DATABASE_ID: this project uses a specific NAMED Firestore
# database, not the "(default)" one — see firebase-applet-config.json's
# firestoreDatabaseId field for the exact value already configured for
# this project. Only override this if you're intentionally pointing at a
# different Firestore database.
FIRESTORE_DATABASE_ID=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Set when frontend is deployed separately (e.g. Vercel) and calls a remote backend API
VITE_API_URL=
